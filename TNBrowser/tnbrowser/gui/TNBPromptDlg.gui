// TNBrowser -- single-line input prompt
//
// The shipped commonDialogs.cs offers MessageBoxOK, MessageBoxOKCancel and
// MessageBoxYesNo but nothing that collects text, so the short edits (clan
// name, tag, website) need this. Built from the same controls and profiles the
// stock dialogs use so it matches them.

new GuiControl(TNBPromptDlg) {
	profile = "DlgBackProfile";
	horizSizing = "width";
	vertSizing = "height";
	position = "0 0";
	extent = "640 480";
	minExtent = "8 8";
	visible = "1";
	helpTag = "0";

	new ShellPaneCtrl(TNBPromptPane) {
		profile = "ShellDlgPaneProfile";
		horizSizing = "center";
		vertSizing = "center";
		position = "160 180";
		extent = "320 130";
		minExtent = "48 92";
		visible = "1";
		helpTag = "0";
		text = "EDIT";
		maxLength = "255";
		noTitleBar = "0";

		new ShellTextEditCtrl(TNBPromptField) {
			profile = "NewTextEditProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "24 40";
			extent = "272 38";
			minExtent = "32 38";
			visible = "1";
			variable = "$TNB::PromptValue";
			altCommand = "TNBPromptAccept();";
			helpTag = "0";
			historySize = "0";
			maxLength = "255";
			password = "0";
			glowOffset = "9 9";
		};
		new ShellBitmapButton() {
			profile = "ShellButtonProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "24 84";
			extent = "128 38";
			minExtent = "32 38";
			visible = "1";
			command = "Canvas.popDialog(TNBPromptDlg);";
			accelerator = "escape";
			helpTag = "0";
			text = "CANCEL";
			simpleStyle = "0";
		};
		new ShellBitmapButton() {
			profile = "ShellButtonProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "168 84";
			extent = "128 38";
			minExtent = "32 38";
			visible = "1";
			command = "TNBPromptAccept();";
			helpTag = "0";
			text = "OK";
			simpleStyle = "0";
		};
	};
};
