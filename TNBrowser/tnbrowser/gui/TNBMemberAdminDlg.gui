		};
		new ShellBitmapButton(TNBRankCancel) {
			profile = "ShellButtonProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "43 195";
			extent = "115 38";
			minExtent = "32 38";
			visible = "1";
			command = "Canvas.popDialog(TNBMemberAdminDlg);";
