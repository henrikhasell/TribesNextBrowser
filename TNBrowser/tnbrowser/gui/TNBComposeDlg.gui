		new ShellBitmapButton(TNBComposeToBtn) {
			profile = "ShellButtonProfile";
			horizSizing = "right";
			vertSizing = "bottom";
			position = "13 30";
			extent = "50 38";
			minExtent = "32 38";
			visible = "1";
			hideCursor = "0";
			bypassHideCursor = "0";
			command = "TNBComposePick();";
			helpTag = "0";
