			minExtent = "8 8";
			visible = "1";
			helpTag = "0";
			text = "Preview:";
			maxLength = "255";
		};
		new ShellFieldCtrl() {
			profile = "ShellFieldProfile";
			horizSizing = "right";
			vertSizing = "bottom";
